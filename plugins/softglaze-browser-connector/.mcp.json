{
  "mcpServers": {
    "softglaze": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/softglaze-browser-bridge.js"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_TOKEN": "${user_config.token}",
        "CLAUDE_PLUGIN_OPTION_PORT": "${user_config.port}"
      }
    }
  }
}
